# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.env
!.env.example

# --- Node / frontend (also covered by frontend/.gitignore) ---
node_modules/
dist/
dist-ssr/
*.local

# --- MQTT secrets / runtime ---
mqttapi/.env
mqttapi/mosquitto/passwd
mqttapi/mosquitto/data/

# --- Production data (do not upload) ---
milesight_data.sql
files/*.csv

# --- IDE / OS ---
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
*.log

# --- Editor / agent tooling ---
.cursor/
.reasonix/
reasonix.toml
/.opencode/